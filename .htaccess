#Options +FollowSymLinks
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

RewriteBase /
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteCond %{SCRIPT_FILENAME} !-d

#RewriteRule ^(.*)$ /index.php/$1 [L]

RewriteRule ^tienda/$  tienda.php [L]
RewriteRule ^tienda$  tienda.php [L]
RewriteRule ^contacto/$  contacto.php [L]
RewriteRule ^contacto$  contacto.php [L]
RewriteRule ^revelar-fotos/$ revelado_1.php [L]
RewriteRule ^revelar-fotos$ revelado_1.php [L]
RewriteRule ^revelado-paso2$ revelado_2.php [L]
RewriteRule ^revelado-paso3$ revelado_3.php [L]
RewriteRule ^revelado-paso4$ revelado_4.php [L]
RewriteRule ^mi-pedido$ miCarro.php [L]
RewriteRule ^checkout$ checkout_1.php [L]
RewriteRule ^checkout-pago$ checkout_2.php [L]
RewriteRule ^checkout-resultado$ checkout_3.php [L]
RewriteRule ^tienda/([a-zA-Z0-9-]+)_([a-zA-Z0-9-]+)/$  tienda.php?id=$1 [L]
RewriteRule ^tienda/([a-zA-Z0-9-]+)_([a-zA-Z0-9-]+)$  tienda.php?id=$1 [L]
RewriteRule ^([a-zA-Z0-9-]+)_([a-zA-Z0-9-]+)$  producto.php?id=$1 [L]
RewriteRule ^recuperar/([a-zA-Z0-9-]+)$  index.php?code=$1 [L]
RewriteRule ^quienes-somos$  index.php#quienes-somos [NE,R]

#modPagespeed off

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php7_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value max_input_vars 10000
   php_value memory_limit 128M
   php_value post_max_size 64M
   php_value session.gc_maxlifetime 86400
   php_value session.save_path "/var/cpanel/php/sessions/ea-php73"
   php_value upload_max_filesize 64M
   php_flag zlib.output_compression Off
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors On
   php_value max_execution_time 300
   php_value max_input_time 300
   php_value max_input_vars 10000
   php_value memory_limit 128M
   php_value post_max_size 64M
   php_value session.gc_maxlifetime 86400
   php_value session.save_path "/var/cpanel/php/sessions/ea-php73"
   php_value upload_max_filesize 64M
   php_flag zlib.output_compression Off
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php73” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php73___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
